# Katalog ze skryptami formularza AIOfficeLab FUNDAMENT.
# Z zewnątrz dostępne są tylko formularz.php i nip.php. Wszystko inne
# (bezpieczenstwo.php, kopie zapasowe, pliki ukryte) jest zablokowane.

Options -Indexes

Require all denied
<FilesMatch "^(formularz|nip)\.php$">
  Require all granted
</FilesMatch>
