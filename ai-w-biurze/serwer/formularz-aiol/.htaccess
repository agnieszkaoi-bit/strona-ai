# Katalog ze skryptami formularza AIOfficeLab FUNDAMENT.
# Dostępne z zewnątrz są tylko formularz.php i nip.php.

Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<Files "bezpieczenstwo.php">
  Require all denied
</Files>

<FilesMatch "\.(bak|old|orig|save|swp|sql|log|ini|sh|txt|md)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always unset X-Powered-By
</IfModule>
