# ═══════════════════════════════════════════════════════════════
# ARK Consulting — arkconsulting.com.pl — konfiguracja Apache/LiteSpeed (Zenbox)
# ═══════════════════════════════════════════════════════════════

# --- Domyślny dokument ---
DirectoryIndex index.html index.php

# --- Wymuszenie HTTPS i domeny bez "www" (kanoniczny adres: https://arkconsulting.com.pl) ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0) Zablokuj niebezpieczne/niepotrzebne metody HTTP (ochrona przed Cross-Site Tracing)
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|CONNECT)$ [NC]
  RewriteRule ^ - [F,L]

  # 1) HTTP -> HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) www.arkconsulting.com.pl -> arkconsulting.com.pl
  RewriteCond %{HTTP_HOST} ^www\.arkconsulting\.com\.pl$ [NC]
  RewriteRule ^ https://arkconsulting.com.pl%{REQUEST_URI} [L,R=301]

  # 3) Pozostałości po WordPressie — jeśli stare pliki nadal fizycznie leżą
  #    na serwerze, blokujemy do nich dostęp (docelowo najlepiej je usunąć
  #    z serwera całkowicie — patrz README.md, sekcja "Bezpieczeństwo")
  RewriteRule ^wp-admin/ - [F,L]
  RewriteRule ^wp-login\.php$ - [F,L]
  RewriteRule ^xmlrpc\.php$ - [F,L]
  RewriteRule ^wp-config(-sample)?\.php$ - [F,L]
</IfModule>

# --- Strona błędu 404 ---
ErrorDocument 404 /404.html

# --- Wyłączenie listowania katalogów ---
Options -Indexes

# --- Kompresja GZIP ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# --- Cache przeglądarki dla zasobów statycznych ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Nagłówki bezpieczeństwa ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # Wymuś HTTPS w przeglądarce nawet przy bezpośrednim wpisaniu http:// (po pierwszej wizycie)
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"

  # Content-Security-Policy — dopuszcza tylko zasoby faktycznie używane przez stronę
  # (Google Fonts, MailerLite). "unsafe-inline" jest potrzebne, bo strona korzysta
  # z atrybutów style="" oraz onload/onerror na obrazkach (odporne ładowanie logo/zdjęć)
  # i danych strukturalnych JSON-LD — nadal blokuje to ładowanie skryptów/stylów
  # z dowolnych obcych, niezaufanych domen.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://assets.mailerlite.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://groot.mailerlite.com; connect-src 'self' https://assets.mailerlite.com"

  # Usuń nagłówek zdradzający wersję PHP (jeśli serwer go dodaje)
  Header unset X-Powered-By
</IfModule>

# --- Blokada bezpośredniego dostępu do plików wrażliwych ---
<FilesMatch "^(\.htaccess|\.htpasswd|\.env|\.git.*|README\.md|IMAGES-NEEDED\.md|composer\.(json|lock)|package(-lock)?\.json)$">
  Require all denied
</FilesMatch>
